# Local engine: cp .env.example .env, then
#   .venv/bin/python -m uvicorn pocketfit.api:app_factory --factory --port 8077 --env-file .env
# For scripts/setup_voice_agent.py: set -a; . ./.env; set +a; .venv/bin/python scripts/setup_voice_agent.py

# Live fitter. Without these the guided flow still works and the live fitter reports "not configured".
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Reading a photo of a launch-monitor screen (Featherless vision model). Without it, photo upload reports
# "not configured"; CSV files and TrackMan report links still work.
FEATHERLESS_API_KEY=
PF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
PF_IMPORTS_PER_HOUR=30

# Used only by scripts/setup_voice_agent.py when creating the agent.
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=gemini-2.5-flash

PF_MODEL_PATH=artifacts/model.joblib
# SQLite file that keeps fits across restarts. Empty keeps them in memory.
PF_STORE_PATH=
# Comma-separated origins allowed to call the engine directly.
PF_CORS_ORIGINS=http://localhost:3000
PF_VOICE_SESSIONS_PER_HOUR=20
PF_LOG_LEVEL=INFO
# Shared secret for the optional /v1/agent/* webhook tools. Empty disables them.
PF_AGENT_SECRET=
