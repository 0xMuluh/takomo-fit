# One-server deploy: cp .env.example .env, fill in, then `docker compose up -d --build`.
# Docker Compose reads .env from this directory automatically.

# Public hostname; Caddy gets the HTTPS certificate for it (camera and microphone need HTTPS).
PF_DOMAIN=fit.example.com

# Live fitter. Key from elevenlabs.io; agent id printed by engine/scripts/setup_voice_agent.py.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Live fitter sessions each visitor may start per hour.
PF_VOICE_SESSIONS_PER_HOUR=20
